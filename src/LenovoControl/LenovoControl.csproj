<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>LenovoControl</AssemblyName>
    <RootNamespace>LenovoControl</RootNamespace>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <Product>Lenovo Control</Product>
    <Description>Lightweight Windows tray utility for switching power profiles.</Description>
    <Authors>LenovoControl contributors</Authors>
  </PropertyGroup>

</Project>
